# ---------------------------------------------------------------
# Copy to .env and fill in your REAL values:   cp .env.example .env
# .env is git-ignored, so updates can never overwrite it.
# ---------------------------------------------------------------
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Primary upload channel
CHANNEL_ID=-1003966911002
# Optional extra channels (comma separated)
EXTRA_CHANNELS=-1002689890343,-1002377422812

# Your Telegram user id, so only you can run /update
ADMINS=

# MongoDB. Leave EMPTY to just use the local JSON file.
MONGO_URI=
